rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ピン（音声ドロップ）: ログインユーザーは閲覧可。作成/更新/削除は本人のみ。
    match /pins/{pinId} {
      allow read: if request.auth != null;
      // 作成時は ownerId が本人であることを必須に（なりすまし投稿を防ぐ）
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      // 更新/削除は自分の投稿だけ
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // プロフィール: アプリ内で他ユーザーの表示名/アイコンを出すため閲覧は全ログインユーザー。
    // 書き込みは本人のみ。
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ログインID→メール の対応表。ログイン時に「未認証の状態で」メール解決するため read は公開。
    //   ※自動生成メール($id@sounddrop.app)前提。実メールの漏えいが気になる段階で
    //     Cloud Functions 経由の解決に切り替える（docs/backend/README.md 参照）。
    match /usernames/{id} {
      allow read: if true;
      // 自分の uid を指す行だけ作成/削除できる
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // 通報: ログインユーザーは「作成」のみ。閲覧/更新は運営ツール(Admin SDK)に限定。
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // 投げ銭/残高など集計系は Cloud Functions(Admin SDK) からのみ書き込む。
    // クライアントからの直接読み書きは既定で拒否（ここに match を書かない＝拒否）。
  }
}
