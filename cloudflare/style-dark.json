{
  "version": 8,
  "name": "SounDrop Dark",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": ["https://tiles.example.com/{z}/{x}/{y}.mvt"],
      "maxzoom": 15,
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#1D2A4C" } },
    { "id": "earth", "type": "fill", "source": "protomaps", "source-layer": "earth",
      "paint": { "fill-color": "#1D2A4C" } },
    { "id": "landuse", "type": "fill", "source": "protomaps", "source-layer": "landuse",
      "paint": { "fill-color": "#222F54", "fill-opacity": 0.6 } },
    { "id": "water", "type": "fill", "source": "protomaps", "source-layer": "water",
      "paint": { "fill-color": "#14203E" } },
    { "id": "roads", "type": "line", "source": "protomaps", "source-layer": "roads",
      "paint": { "line-color": "#3A4575",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 14, 2.5] } },
    { "id": "buildings", "type": "fill", "source": "protomaps", "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#2A3766", "fill-opacity": 0.7 } },
    { "id": "boundaries", "type": "line", "source": "protomaps", "source-layer": "boundaries",
      "paint": { "line-color": "#4A5590", "line-dasharray": [2, 2], "line-width": 0.6 } },
    { "id": "places", "type": "symbol", "source": "protomaps", "source-layer": "places",
      "layout": {
        "text-field": ["coalesce", ["get", "name:ja"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 14, 14]
      },
      "paint": {
        "text-color": "#EAEEFB",
        "text-halo-color": "#1D2A4C",
        "text-halo-width": 1.2
      } }
  ]
}
